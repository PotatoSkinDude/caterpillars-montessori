---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>
	<section class="relative pt-24 pb-8 px-6 text-center overflow-hidden">
		<div class="absolute top-10 left-16 w-28 h-28 bg-pink-300 rounded-full opacity-70 blur-lg"></div>
		<div class="absolute bottom-6 right-10 w-32 h-32 bg-blue-300 rounded-full opacity-70 blur-lg"></div>
		<div class="absolute top-1/3 left-1/2 w-24 h-24 bg-yellow-300 rounded-full opacity-60 blur-xl"></div>

		<div class="relative z-10 max-w-3xl mx-auto">
			<span class="inline-flex items-center gap-2 bg-white text-green-700 text-sm font-semibold px-5 py-2 rounded-full shadow-sm mb-6 border border-green-100">
				🎒 Join Our Family
			</span>
			<h1 class="text-5xl md:text-6xl font-extrabold text-gray-900 mb-4 leading-tight">
				Your child's <span class="relative inline-block text-green-600">
					next big step
					<svg class="absolute -bottom-1 left-0 w-full" viewBox="0 0 200 12" preserveAspectRatio="none">
						<path d="M2 9 Q 50 2, 100 7 T 198 6" stroke="#fbbf24" stroke-width="5" fill="none" stroke-linecap="round"/>
					</svg>
				</span>
			</h1>
			<p class="text-lg text-gray-600 max-w-xl mx-auto">
				We'd love to welcome your child. Explore our programs below, or reach out to schedule a visit.
			</p>
		</div>
	</section>

	<section id="programs" class="relative pt-4 py-16 px-6 overflow-hidden">
		<div class="absolute top-4 left-4 w-40 h-40 bg-pink-300 rounded-full opacity-70 blur-lg"></div>
		<div class="absolute bottom-4 right-4 w-36 h-36 bg-yellow-300 rounded-full opacity-70 blur-lg"></div>

		<div class="relative max-w-6xl mx-auto p-8 md:p-12 bg-blue-100 border-[3px] border-blue-400 rounded-[255px_15px_225px_15px/15px_225px_15px_255px]">
			<div class="text-center mb-12">
				<p class="text-green-600 font-semibold uppercase tracking-wide text-sm mb-2">Programs by Age</p>
				<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
					A path for every stage of growth
				</h2>
				<p class="text-gray-600 max-w-2xl mx-auto">
					Each stage builds on the last — same Montessori heart, growing skills, all the way to school-ready.
				</p>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
				<div class="bg-white rounded-2xl shadow-md overflow-hidden">
					<img src="/images/pic2.jpg" alt="Pre-K program" class="w-full h-48 object-cover" />
					<div class="p-5">
						<span class="inline-block bg-blue-100 text-blue-700 text-xs font-semibold px-3 py-1 rounded-full mb-3">AGE RANGE</span>
						<h3 class="text-lg font-bold text-gray-900 mb-1">Nursery</h3>
						<p class="text-sm text-gray-500 font-medium mb-2">Nursery 1,2,3</p>
						<p class="text-gray-600 text-sm">A nurturing environment for young learners from ages 2-5.</p>
					</div>
				</div>

				<div class="bg-white rounded-2xl shadow-md overflow-hidden">
					<img src="/images/pic5.jpg" alt="KG1 program" class="w-full h-48 object-cover" />
					<div class="p-5">
						<span class="inline-block bg-yellow-100 text-yellow-700 text-xs font-semibold px-3 py-1 rounded-full mb-3">AGE RANGE</span>
						<h3 class="text-lg font-bold text-gray-900 mb-1">KG1</h3>
						<p class="text-sm text-gray-500 font-medium mb-2">Kindergarten 1</p>
						<p class="text-gray-600 text-sm">A fun and engaging environment for children ages 5-6.</p>
					</div>
				</div>

				<div class="bg-white rounded-2xl shadow-md overflow-hidden">
					<img src="/images/pic6.jpg" alt="KG2 program" class="w-full h-48 object-cover" />
					<div class="p-5">
						<span class="inline-block bg-teal-100 text-teal-700 text-xs font-semibold px-3 py-1 rounded-full mb-3">AGE RANGE</span>
						<h3 class="text-lg font-bold text-gray-900 mb-1">KG2</h3>
						<p class="text-sm text-gray-500 font-medium mb-2">Kindergarten 2</p>
						<p class="text-gray-600 text-sm">A supportive environment for children ages 6-7 developing independence and social skills.</p>
					</div>
				</div>

				<div class="bg-white rounded-2xl shadow-md overflow-hidden">
					<img src="/images/pic7.jpg" alt="KG3 program" class="w-full h-48 object-cover" />
					<div class="p-5">
						<span class="inline-block bg-red-100 text-red-700 text-xs font-semibold px-3 py-1 rounded-full mb-3">AGE RANGE</span>
						<h3 class="text-lg font-bold text-gray-900 mb-1">KG3</h3>
						<p class="text-sm text-gray-500 font-medium mb-2">Kindergarten 3</p>
						<p class="text-gray-600 text-sm">A stimulating environment for children ages 7-8 preparing for the transition to elementary school.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="relative py-16 px-6 overflow-hidden">
		<div class="absolute top-4 left-[20%] w-32 h-32 bg-blue-300 rounded-full opacity-70 blur-lg"></div>
		<div class="absolute bottom-4 right-[20%] w-36 h-36 bg-pink-300 rounded-full opacity-70 blur-lg"></div>

		<div class="relative max-w-3xl mx-auto p-8 md:p-10 bg-green-100 border-[3px] border-green-400 rounded-[15px_255px_15px_225px/225px_15px_255px_15px] text-center">
			<h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
				Come see it for yourself
			</h2>
			<p class="text-gray-600 mb-8 max-w-xl mx-auto">
				We invite you to visit any of our campuses and see why so many families have trusted Caterpillars Montessori with their child's first steps into education.
			</p>
			<a href="/contact" class="inline-block bg-green-500 hover:bg-green-600 text-white font-semibold px-8 py-3 rounded-full shadow-md transition-colors">
				Schedule a Visit
			</a>
		</div>
	</section>
</BaseLayout>