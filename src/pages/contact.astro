---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout>
	<!-- Hero -->
	<section class="relative pt-24 pb-8 px-6 text-center overflow-hidden">
		<div class="absolute top-6 right-14 w-28 h-28 bg-yellow-300 rounded-full opacity-70 blur-lg"></div>
		<div class="absolute bottom-0 left-12 w-32 h-32 bg-pink-300 rounded-full opacity-70 blur-lg"></div>
		<div class="absolute top-1/2 right-1/3 w-24 h-24 bg-blue-300 rounded-full opacity-60 blur-xl"></div>

		<div class="relative z-10 max-w-3xl mx-auto">
			<span class="inline-flex items-center gap-2 bg-white text-green-700 text-sm font-semibold px-5 py-2 rounded-full shadow-sm mb-6 border border-green-100">
				💬 Let's Talk
			</span>

			<h1 class="text-5xl md:text-6xl font-extrabold text-gray-900 mb-4 leading-tight">
				We'd love to
				<span class="relative inline-block text-green-600">
					hear from you
					<svg
						class="absolute -bottom-1 left-0 w-full"
						viewBox="0 0 200 12"
						preserveAspectRatio="none"
					>
						<path
							d="M2 9 Q 50 2, 100 7 T 198 6"
							stroke="#fbbf24"
							stroke-width="5"
							fill="none"
							stroke-linecap="round"
						/>
					</svg>
				</span>
			</h1>

			<p class="text-lg text-gray-600 max-w-xl mx-auto">
				Reach out to schedule a visit or ask any questions — we're just a message away.
			</p>
		</div>
	</section>

	<!-- Campus Contact Details -->
	<section class="relative py-10 px-6 overflow-hidden">
		<div class="absolute top-4 left-4 w-40 h-40 bg-pink-300 rounded-full opacity-70 blur-lg"></div>
		<div class="absolute bottom-4 right-4 w-36 h-36 bg-yellow-300 rounded-full opacity-70 blur-lg"></div>

		<div class="relative max-w-6xl mx-auto p-8 md:p-12 bg-red-50 border-[3px] border-red-400 rounded-[255px_15px_225px_15px/15px_225px_15px_255px] grid md:grid-cols-3 gap-10">

			<!-- Alam Sutera -->
			<div>
				<h2 class="text-2xl font-bold text-gray-900 mb-6">
					Alam Sutera Campus
				</h2>

				<div class="space-y-5 min-h-[216px]">
					<div class="flex items-center gap-4">
						<span class="bg-green-100 text-green-600 rounded-full w-12 h-12 flex items-center justify-center text-xl flex-shrink-0">
							📍
						</span>
						<div>
							<p class="font-semibold text-gray-900">Address</p>
							<p class="text-gray-600">
								Alam Sutera, Tangerang, Banten 15331
							</p>
						</div>
					</div>

					<div class="flex items-center gap-4">
						<span class="bg-blue-100 text-blue-600 rounded-full w-12 h-12 flex items-center justify-center text-xl flex-shrink-0">
							📞
						</span>
						<div>
							<p class="font-semibold text-gray-900">Phone / WhatsApp</p>
							<p class="text-gray-600">
								+62 812-9221-5733
							</p>
						</div>
					</div>

					<div class="flex items-center gap-4">
						<span class="bg-yellow-100 text-yellow-600 rounded-full w-12 h-12 flex items-center justify-center text-xl flex-shrink-0">
							✉️
						</span>
						<div>
							<p class="font-semibold text-gray-900">Instagram</p>
							<p class="text-gray-600">
								@caterpillarsmontessori_alsut
							</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Cikarang -->
			<div>
				<h2 class="text-2xl font-bold text-gray-900 mb-6">
					Cikarang Campus
				</h2>

				<div class="space-y-5 min-h-[216px]">
					<div class="flex items-center gap-4">
						<span class="bg-green-100 text-green-600 rounded-full w-12 h-12 flex items-center justify-center text-xl flex-shrink-0">
							📍
						</span>
						<div>
							<p class="font-semibold text-gray-900">Address</p>
							<p class="text-gray-600">
								Cikarang Selatan, Bekasi, Jawa Barat 17530
							</p>
						</div>
					</div>

					<div class="flex items-center gap-4">
						<span class="bg-blue-100 text-blue-600 rounded-full w-12 h-12 flex items-center justify-center text-xl flex-shrink-0">
							📞
						</span>
						<div>
							<p class="font-semibold text-gray-900">Phone / WhatsApp</p>
							<p class="text-gray-600">
								+62 812-1331-9889
							</p>
						</div>
					</div>

					<div class="flex items-center gap-4">
						<span class="bg-yellow-100 text-yellow-600 rounded-full w-12 h-12 flex items-center justify-center text-xl flex-shrink-0">
							✉️
						</span>
						<div>
							<p class="font-semibold text-gray-900">Instagram</p>
							<p class="text-gray-600">
								@caterpillarsmontessoricikarang
							</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Bali -->
			<div>
				<h2 class="text-2xl font-bold text-gray-900 mb-6">
					Bali Campus
				</h2>

				<div class="space-y-5 min-h-[216px]">
					<div class="flex items-center gap-4">
						<span class="bg-green-100 text-green-600 rounded-full w-12 h-12 flex items-center justify-center text-xl flex-shrink-0">
							📍
						</span>
						<div>
							<p class="font-semibold text-gray-900">Address</p>
							<p class="text-gray-600">
								Renon, Denpasar Selatan, Bali 80239
							</p>
						</div>
					</div>

					<div class="flex items-center gap-4">
						<span class="bg-blue-100 text-blue-600 rounded-full w-12 h-12 flex items-center justify-center text-xl flex-shrink-0">
							📞
						</span>
						<div>
							<p class="font-semibold text-gray-900">Phone / WhatsApp</p>
							<p class="text-gray-600">
								0813-5325-7877
							</p>
						</div>
					</div>

					<div class="flex items-center gap-4">
						<span class="bg-yellow-100 text-yellow-600 rounded-full w-12 h-12 flex items-center justify-center text-xl flex-shrink-0">
							✉️
						</span>
						<div>
							<p class="font-semibold text-gray-900">Instagram</p>
							<p class="text-gray-600">
								@caterpillarsmontessori
							</p>
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Maps -->
	<section class="py-16 px-6 max-w-6xl mx-auto grid md:grid-cols-3 gap-10">
		<div class="rounded-2xl overflow-hidden shadow-md border-4 border-white ring-1 ring-gray-100">
			<iframe
				src="https://www.google.com/maps?q=Caterpillars+Montessori+Alam+Sutera,+Tangerang&output=embed"
				width="100%"
				height="280"
				style="border:0;"
				allowfullscreen
				loading="lazy"
			></iframe>
		</div>

		<div class="rounded-2xl overflow-hidden shadow-md border-4 border-white ring-1 ring-gray-100">
			<iframe
				src="https://www.google.com/maps?q=Caterpillars+Montessori+Cikarang,+Bekasi&output=embed"
				width="100%"
				height="280"
				style="border:0;"
				allowfullscreen
				loading="lazy"
			></iframe>
		</div>

		<div class="rounded-2xl overflow-hidden shadow-md border-4 border-white ring-1 ring-gray-100">
			<iframe
				src="https://www.google.com/maps?q=Caterpillars+Montessori+Renon,+Denpasar&output=embed"
				width="100%"
				height="280"
				style="border:0;"
				allowfullscreen
				loading="lazy"
			></iframe>
		</div>
	</section>
</BaseLayout>