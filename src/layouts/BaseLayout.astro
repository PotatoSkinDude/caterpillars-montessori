---
import '../styles/global.css';
---
<html lang="en">
    <head>
        <meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        <title>Caterpillars Montessori</title>
    </head>
    <body>
		<header>
			<div class="header-blob header-blob-1"></div>
			<div class="header-blob header-blob-2"></div>
			<div class="header-blob header-blob-3"></div>

			<a href="/" class="logo-link">
				<img src="/images/logo.png" alt="Caterpillars Montessori" class="h-14 w-auto" />
			</a>
			<nav>
				<ul>
					<li><a href="/">Home</a></li>
					<li><a href="/about">About</a></li>
					<li><a href="/gallery">Gallery</a></li>
					<li><a href="/admissions">Admissions</a></li>
					<li><a href="/contact">Contact</a></li>
				</ul>
			</nav>
		</header>

        <main>
            <slot />
        </main>

		<footer class="bg-gray-900 text-gray-200 py-12 px-6">
			<div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-8">
				<div>
					<h3 class="text-white font-bold text-lg mb-3">Caterpillars Montessori</h3>
					<p class="text-sm text-gray-400">
						Nurturing curious minds through the Montessori method in Alam Sutera, Cikarang, and Bali.
					</p>
				</div>
				<div>
					<h4 class="text-white font-semibold mb-3">Quick Links</h4>
					<ul class="space-y-2 text-sm">
						<li><a href="/" class="hover:text-green-400">Home</a></li>
						<li><a href="/about" class="hover:text-green-400">About</a></li>
						<li><a href="/gallery" class="hover:text-green-400">Gallery</a></li>
						<li><a href="/admissions" class="hover:text-green-400">Admissions</a></li>
						<li><a href="/contact" class="hover:text-green-400">Contact</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-white font-semibold mb-3">Contact</h4>
					<p class="text-sm text-gray-400">Alam Sutera, Tangerang</p>
					<p class="text-sm text-gray-400">Cikarang, Bekasi</p>
					<p class="text-sm text-gray-400">Denpasar, Bali</p>
					<p class="text-sm text-gray-400 mt-3">Email: info@caterpillarsmontessori.com</p>
				</div>
			</div>
			<div class="text-center text-xs text-gray-500 mt-10 border-t border-gray-800 pt-6">
				© {new Date().getFullYear()} Caterpillars Montessori. All rights reserved.
			</div>
		</footer>

		<!-- Floating Contact Buttons -->
		<div class="floating-contact">
			<!-- WhatsApp -->
			<div class="fab-wrapper">
				<button class="fab fab-whatsapp" aria-label="Chat on WhatsApp">
